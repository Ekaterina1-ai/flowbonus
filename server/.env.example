# FlowBonus — пример переменных окружения.
# На сервере файл лежит в /etc/flowbonus.env (создаётся deploy.sh).
# Локально можно скопировать в server/.env и подхватывать вручную — приложение
# читает только переменные окружения, .env-файл само не парсит.

# Ключ подписи cookie-сессий. ОБЯЗАТЕЛЬНО свой, случайный, минимум 32 символа.
# Сгенерировать: python3 -c "import secrets; print(secrets.token_urlsafe(48))"
# Если не задан — приложение создаст server/.secret_key и будет использовать его.
SECRET_KEY=replace-me-with-random-string

# Файл базы SQLite. Держите его ВНЕ каталога с кодом, иначе git-обновление
# перезапишет рабочие данные.
FLOWBONUS_DB_PATH=/var/lib/flowbonus/flowbonus.db

# Каталог, куда сохраняются фотографии партнёров (тоже вне каталога с кодом).
FLOWBONUS_UPLOAD_DIR=/var/lib/flowbonus/uploads

# Максимальный размер загружаемого файла в мегабайтах.
# Должен совпадать с client_max_body_size в конфиге nginx.
MAX_UPLOAD_MB=20

# Приложение работает за nginx — доверяем заголовкам X-Forwarded-*.
TRUST_PROXY=1

# Ставить 1 ТОЛЬКО после подключения HTTPS, иначе вход перестанет работать.
SESSION_COOKIE_SECURE=0

# Адрес и порт для локального запуска (python app.py). В systemd не используются.
HOST=127.0.0.1
PORT=5500
FLASK_DEBUG=0
