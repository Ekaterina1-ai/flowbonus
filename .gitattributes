# В индексе всегда LF, независимо от настроек core.autocrlf у разработчика.
* text=auto

# Эти файлы исполняются на Linux-сервере и должны быть с LF и в рабочей копии:
# при CRLF bash падает с ошибкой "$'\r': command not found".
*.sh          text eol=lf
*.py          text eol=lf
*.service     text eol=lf
*.conf        text eol=lf
.env.example  text eol=lf

# Бинарные файлы git не нормализует.
*.png  binary
*.jpg  binary
*.jpeg binary
*.ico  binary
*.db   binary
